javascript:(function(){var t=document.title,u=location.href,h=location.hostname.replace(/^www\./,''),p=h.split('.'),m='co.uk,org.uk,gov.uk,ac.uk,me.uk,ltd.uk,plc.uk,net.uk,sch.uk,com.au,net.au,org.au,edu.au,gov.au,id.au,co.nz,net.nz,org.nz,govt.nz,co.jp,ne.jp,or.jp,ac.jp,go.jp,ad.jp,co.kr,ne.kr,go.kr,com.br,net.br,org.br,gov.br,com.cn,net.cn,org.cn,gov.cn,com.tw,net.tw,org.tw,gov.tw,co.za,org.za,gov.za,co.in,net.in,org.in,gov.in,ac.in,firm.in,com.mx,com.sg,net.sg,org.sg,gov.sg,com.hk,net.hk,org.hk,gov.hk,co.il,org.il,net.il,com.tr,gov.tr,co.id,or.id,go.id,ac.id,com.ar,net.ar,org.ar,com.co,net.co,org.co,co.th,in.th,or.th,ac.th,go.th,com.my,net.my,org.my,gov.my,co.ke,co.ug,co.tz,com.ng,com.pk,com.eg,com.sa'.split(','),l2=p.slice(-2).join('.'),d=(p.length>2&&m.indexOf(l2)>-1)?p.slice(-3).join('.'):l2,s='['+t+']('+u+') ('+d+')';if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(s);}else{var a=document.createElement('textarea');a.style.position='fixed';a.style.opacity='0';a.value=s;document.body.appendChild(a);a.focus();a.select();try{document.execCommand('copy');}catch(e){console.log('Copy failed',e);}document.body.removeChild(a);}})();
